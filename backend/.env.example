# VibeGrade Backend Configuration
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database
# Development: SQLite (file-based, no server needed)
DATABASE_URL=sqlite+aiosqlite:///./vibegrade.db

# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vibegrade

# GitHub API (optional - increases rate limit from 60/hr to 5000/hr)
# Create a personal access token at https://github.com/settings/tokens
# No scopes needed for public repo access
GITHUB_TOKEN=

# Rubric
RUBRIC_VERSION=v1
RUBRIC_PATH=../rubric/v1.yaml

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-min-32-chars

# Session (for future auth)
SESSION_COOKIE_NAME=vibegrade_session
SESSION_MAX_AGE=86400  # 24 hours

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Scan Limits
MAX_REPO_SIZE_MB=500
MAX_CLONE_DEPTH=1
SCAN_TIMEOUT_SECONDS=300

# Sandbox (Phase 2)
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=vibegrade/sandbox:latest
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_PIDS_LIMIT=100
SANDBOX_TIMEOUT_SECONDS=120

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173